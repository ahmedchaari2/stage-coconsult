# Local Docker Compose configuration.  This file deliberately mirrors the
# current defaults stored in config-repo.  Do not commit it.

# PostgreSQL
DB_PASSWORD=chaari10

# RabbitMQ uses a dedicated non-guest account because RabbitMQ blocks guest
# connections originating from another container.
RABBITMQ_USER=medtrack
RABBITMQ_PASSWORD=medtrack
RABBITMQ_MANAGEMENT_PORT=15673

# Eureka
EUREKA_USER=eureka
EUREKA_PASSWORD=eurekapass

# Shared JWT signing key
JWT_SECRET=medtrack_jwt_super_secret_key_2026_very_long_random_string_48_chars_min

# SMTP credentials used by user-service and notification-service
MAIL_PASSWORD=ijzz cyfy qkhp vjoe

